From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Wed, 19 Aug 2026 01:01:25 +0800
Subject: [PATCH] Avoid external redirect in canonical host test

Signed-off-by: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
---
 canonical_test.go | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/canonical_test.go b/canonical_test.go
index 2b11ccf..573d420 100644
--- a/canonical_test.go
+++ b/canonical_test.go
@@ -109,10 +109,16 @@ func TestHeaderWrites(t *testing.T) {
 	defer srv.Close()
 	srv.Config.ErrorLog = tl
 
-	_, err := http.Get(srv.URL)
+	client := &http.Client{
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	resp, err := client.Get(srv.URL)
 	if err != nil {
 		t.Fatal(err)
 	}
+	defer resp.Body.Close()
 
 	err = buf.Flush()
 	if err != nil {
